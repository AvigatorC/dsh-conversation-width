{
  "name": "dsh-conversation-width",
  "version": "1.0.0",
  "description": "Fix the conversation column width — a pixel width or a share of the window — from a row in the General settings page. A DeepSeek Harness (dsh) Web UI plugin.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "conversation",
    "dialog",
    "width",
    "layout",
    "settings"
  ],
  "license": "MIT",
  "author": "Avigator (https://github.com/AvigatorC)",
  "homepage": "https://github.com/AvigatorC/dsh-conversation-width#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvigatorC/dsh-conversation-width.git"
  },
  "bugs": {
    "url": "https://github.com/AvigatorC/dsh-conversation-width/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
